# Track only the two project directories.
/*
!.gitignore
!investment-back/
!investment-back/**
!investment-front/
!investment-front/**

# Local AI / editor tooling
.codex/
.claude/
.trae/

# Temporary work directories
.tmp-front-install/
.npm-cache/

# Environment files
.env
.env.*
!.env.example
!**/.env.example
investment-back/.env
investment-back/.env.*
!investment-back/.env.example
investment-front/.env
investment-front/.env.*
!investment-front/.env.example

# Python
__pycache__/
**/__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
investment-back/__pycache__/
investment-back/**/__pycache__/
investment-back/.pytest_cache/
investment-back/.mypy_cache/
investment-back/.ruff_cache/
investment-back/.venv/

# Node.js
node_modules/
dist/
build/
investment-front/node_modules/
investment-front/dist/
investment-front/build/

# Logs and coverage
*.log
.coverage
.coverage.*
htmlcov/
coverage/
playwright-report/
test-results/
.playwright/
investment-back/htmlcov/
investment-back/coverage/
investment-front/coverage/
investment-front/playwright-report/
investment-front/test-results/
investment-front/.playwright/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
