# 应用配置
APP_NAME=AI金融素养教练
APP_VERSION=1.0.0
DEBUG=True
ENVIRONMENT=development
API_PREFIX=/api/v1

# 数据库配置
DATABASE_URL=postgresql://postgres:123456@localhost:5432/investment_db
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# JWT配置
SECRET_KEY=dev-local-secret-key-not-for-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS配置
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# 文件上传
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=10485760

# AI配置
AI_API_KEY=a37cc339-b87a-45a1-bd09-035010baf1ef
AI_MODEL=glm-4-7-251222
AI_API_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
AI_API_TIMEOUT=30

# 市场数据
STOCK_DATA_TIMEOUT=3.0
STOCK_DATA_CACHE_SECONDS=180
STOCK_NOTICE_LOOKBACK_DAYS=30

# 异步任务队列
REDIS_URL=redis://localhost:6379/0
RQ_ASYNC=true
