# 应用配置
APP_NAME=AI投资决策助手
APP_VERSION=1.0.0
DEBUG=True
API_PREFIX=/api/v1

# 数据库配置
DATABASE_URL=postgresql://user:password@localhost:5432/investment_db
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# JWT配置
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS配置
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# 文件上传
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=10485760

# AI配置
AI_API_KEY=your-ai-api-key-here
AI_MODEL=claude-3-opus-20240229

# Runtime environment
ENVIRONMENT=development

# Market data
STOCK_DATA_TIMEOUT=3.0
STOCK_DATA_CACHE_SECONDS=180
STOCK_NOTICE_LOOKBACK_DAYS=30

# Async analysis execution
# development/test: RQ_ASYNC=true uses FastAPI BackgroundTasks.
# staging/production: RQ_ASYNC=false requires Redis plus a separate worker:
#   python -m src.workers
REDIS_URL=redis://localhost:6379/0
RQ_ASYNC=true
